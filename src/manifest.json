{
  "manifest_version": 3,
  "name": "Copilot for Botmaker",
  "version": "0.4.1",
  "description": "Copiloto para operadores de Botmaker: seleccion multiple, acciones masivas y motor de reglas.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": ["https://*.botmaker.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "action": {
    "default_title": "Copilot for Botmaker"
  },
  "content_scripts": [
    {
      "matches": ["https://*.botmaker.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
